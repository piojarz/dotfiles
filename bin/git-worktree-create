#!/usr/bin/env bash

# Git Worktree Create - Smart worktree creation with branch naming conventions
# Supports: feature (default), chore, fix, refactor, and jira modes

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default values
PREFIX="feature"
JIRA_MODE=false
BASE_BRANCH=""

# Usage information
usage() {
    cat << EOF
Usage: $(basename "$0") [OPTIONS] <name-or-description>

Create a new git worktree with smart branch naming.

Examples:
  # Feature branch (default)
  $(basename "$0") "Add user authentication"
  → Branch: feature/add-user-authentication
  → Worktree: feature-add-user-authentication/

  # With specific type
  $(basename "$0") --chore "Update dependencies"
  → Branch: chore/update-dependencies

  $(basename "$0") --fix "Fix memory leak in parser"
  → Branch: fix/fix-memory-leak-in-parser

  $(basename "$0") --refactor "Extract auth module"
  → Branch: refactor/extract-auth-module

  # JIRA issue
  $(basename "$0") --jira "SM-212 Page not rendering"
  → Branch: SM-212/page-not-rendering

  # Explicit branch name (no transformation)
  $(basename "$0") feature/custom-auth
  → Branch: feature/custom-auth (uses as-is)

Options:
  -h, --help          Show this help message
  -j, --jira          JIRA mode: TICKET-123/description format
  -c, --chore         Prefix with chore/
  -f, --fix           Prefix with fix/
  -r, --refactor      Prefix with refactor/
  -b, --base BRANCH   Base branch (default: main or master)

Aliases:
  git wtc             Shortcut for $(basename "$0")
  git wtcj            Shortcut with --jira flag
  git wtcc            Shortcut with --chore flag
  git wtcf            Shortcut with --fix flag
  git wtcr            Shortcut with --refactor flag

EOF
    exit 0
}

# Parse command line arguments
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                usage
                ;;
            -j|--jira)
                JIRA_MODE=true
                PREFIX=""
                shift
                ;;
            -c|--chore)
                PREFIX="chore"
                JIRA_MODE=false
                shift
                ;;
            -f|--fix)
                PREFIX="fix"
                JIRA_MODE=false
                shift
                ;;
            -r|--refactor)
                PREFIX="refactor"
                JIRA_MODE=false
                shift
                ;;
            -b|--base)
                if [[ -n "${2:-}" && ! "$2" =~ ^- ]]; then
                    BASE_BRANCH="$2"
                    shift 2
                else
                    echo -e "${RED}Error: --base requires a branch name${NC}"
                    exit 1
                fi
                ;;
            -*)
                echo -e "${RED}Error: Unknown option $1${NC}"
                echo "Use --help for usage information"
                exit 1
                ;;
            *)
                # This is the description/branch name
                break
                ;;
        esac
    done

    # Check if we have input
    if [[ $# -eq 0 ]]; then
        echo -e "${RED}Error: No branch name or description provided${NC}"
        echo "Use --help for usage information"
        exit 1
    fi

    # Join all remaining arguments as the input
    INPUT="$*"
}

# Check if we're in a bare repo or regular repo with .bare directory
check_repo() {
    # Check if we're in a bare repo setup (has .bare directory)
    if [[ -d ".bare" ]]; then
        BARE_REPO=true
        BARE_DIR=".bare"
    # Check if this is a bare repo (git rev-parse --is-bare-repository returns "true")
    elif [[ "$(git rev-parse --is-bare-repository 2>/dev/null)" == "true" ]]; then
        BARE_REPO=true
        BARE_DIR="."
    # Check if we're in a regular repo
    elif git rev-parse --git-dir &>/dev/null; then
        BARE_REPO=false
    else
        echo -e "${RED}Error: Not a git repository${NC}"
        exit 1
    fi
}

# Convert input to kebab-case
kebab_case() {
    echo "$1" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr -s '-' | sed 's/^-//;s/-$//'
}

# Detect base branch (main or master)
detect_base_branch() {
    if [[ -n "$BASE_BRANCH" ]]; then
        return
    fi

    # Check for main first, then master
    if git show-ref --verify --quiet refs/heads/main; then
        BASE_BRANCH="main"
    elif git show-ref --verify --quiet refs/heads/master; then
        BASE_BRANCH="master"
    else
        # Use current HEAD if no main/master
        BASE_BRANCH="HEAD"
    fi
}

# Generate branch name and worktree directory from input
generate_names() {
    local input="$1"

    # Check if input contains '/' - treat as explicit branch name
    if [[ "$input" == *"/"* ]]; then
        BRANCH_NAME="$input"
        # For worktree directory, replace / with -
        WORKTREE_NAME=$(echo "$input" | tr '/' '-')
        echo -e "${BLUE}Using explicit branch name: $BRANCH_NAME${NC}"
        return
    fi

    # JIRA mode
    if [[ "$JIRA_MODE" == true ]]; then
        # Extract JIRA ticket ID (e.g., SM-212, PROJ-1234)
        if [[ "$input" =~ ^([A-Z]+-[0-9]+)[[:space:]]+(.+)$ ]]; then
            local ticket="${BASH_REMATCH[1]}"
            local description="${BASH_REMATCH[2]}"
            local kebab_desc=$(kebab_case "$description")
            BRANCH_NAME="${ticket}/${kebab_desc}"
            WORKTREE_NAME="${ticket}-${kebab_desc}"
            echo -e "${BLUE}JIRA ticket detected: $ticket${NC}"
        else
            # If no JIRA pattern found, treat entire input as branch name
            BRANCH_NAME=$(kebab_case "$input")
            WORKTREE_NAME="$BRANCH_NAME"
            echo -e "${YELLOW}Warning: No JIRA ticket pattern found (e.g., SM-123). Using as-is.${NC}"
        fi
    else
        # Standard mode with prefix
        local kebab_input=$(kebab_case "$input")
        BRANCH_NAME="${PREFIX}/${kebab_input}"
        WORKTREE_NAME="${PREFIX}-${kebab_input}"
    fi
}

# Check if branch already exists
check_existing_branch() {
    if git show-ref --verify --quiet "refs/heads/$BRANCH_NAME"; then
        echo -e "${RED}Error: Branch '$BRANCH_NAME' already exists${NC}"
        echo "Use 'git worktree add ../$WORKTREE_NAME $BRANCH_NAME' to checkout existing branch"
        exit 1
    fi

    # Check if worktree directory already exists
    if [[ -d "../$WORKTREE_NAME" ]]; then
        echo -e "${RED}Error: Directory '../$WORKTREE_NAME' already exists${NC}"
        exit 1
    fi

    # Check if worktree for this branch already exists
    if git worktree list | grep -q "\[${BRANCH_NAME}\]"; then
        echo -e "${RED}Error: Worktree for branch '$BRANCH_NAME' already exists${NC}"
        git worktree list | grep "\[${BRANCH_NAME}\]"
        exit 1
    fi
}

# Create the worktree and branch
create_worktree() {
    echo -e "${BLUE}Creating worktree...${NC}"
    echo -e "  Branch: ${GREEN}$BRANCH_NAME${NC}"
    echo -e "  Base:   ${YELLOW}$BASE_BRANCH${NC}"
    echo -e "  Path:   ${BLUE}../$WORKTREE_NAME${NC}"

    # Create worktree with new branch
    git worktree add -b "$BRANCH_NAME" "../$WORKTREE_NAME" "$BASE_BRANCH"

    echo -e "${GREEN}✓ Worktree created successfully!${NC}"
    echo ""
    echo -e "To switch to the new worktree:"
    echo -e "  ${YELLOW}cd ../$WORKTREE_NAME${NC}"
    echo ""
    echo -e "To push this branch to origin:"
    echo -e "  ${YELLOW}git pnb${NC}  (or: git push -u origin $BRANCH_NAME)"
}

# Copy convenience files if they exist (like .env, node_modules, etc.)
copy_convenience_files() {
    local source_dir=""
    
    # Find source directory (main or master worktree, or current directory)
    if [[ -d "../main" ]]; then
        source_dir="../main"
    elif [[ -d "../master" ]]; then
        source_dir="../master"
    elif [[ "$BARE_REPO" == false ]]; then
        source_dir="."
    fi

    if [[ -n "$source_dir" && -d "$source_dir" ]]; then
        local copied_something=false
        
        # Copy common convenience files
        for file in ".env" ".envrc" ".env.local" ".tool-versions" "mise.toml"; do
            if [[ -f "$source_dir/$file" && ! -f "../$WORKTREE_NAME/$file" ]]; then
                cp "$source_dir/$file" "../$WORKTREE_NAME/$file"
                echo -e "${BLUE}Copied: $file${NC}"
                copied_something=true
            fi
        done

        # Note about node_modules (usually not copied due to size)
        if [[ -d "$source_dir/node_modules" ]]; then
            echo -e "${YELLOW}Note: node_modules not copied. Run 'npm install' or 'yarn install' in the new worktree.${NC}"
        fi
    fi
}

# Main execution
main() {
    parse_args "$@"
    check_repo
    detect_base_branch
    generate_names "$INPUT"
    check_existing_branch
    create_worktree
    copy_convenience_files
}

main "$@"
