#!/usr/bin/env bash

# Dotfiles Add - Add a new configuration file to the dotfiles repository

set -e

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$DOTFILES_DIR/scripts/common/utils.sh"

usage() {
  cat << EOF
Usage: $(basename "${BASH_SOURCE[0]}") [-h] [-c category] <file_path>

Add a new configuration file to the dotfiles repository.

Options:
  -h, --help      Show this help message and exit
  -c, --category  Category: common, macos, linux (default: auto-detect)
  
Examples:
  $(basename "${BASH_SOURCE[0]}") ~/.config/nvim/init.lua
  $(basename "${BASH_SOURCE[0]}") -c macos ~/.hammerspoon/init.lua
EOF
  exit 0
}

detect_category() {
  local file="$1"
  local filename=$(basename "$file")
  
  # Auto-detect based on file location or type
  if [[ "$file" == *".hammerspoon"* ]]; then
    echo "macos"
  elif [[ "$file" == *".config"* ]]; then
    # Check if it's a common tool
    local config_name=$(basename "$(dirname "$file")")
    case "$config_name" in
      nvim|tmux|git|zsh|kitty|lazygit|kanata|ripgrep|sesh)
        echo "common"
        ;;
      *)
        echo "common"
        ;;
    esac
  else
    echo "common"
  fi
}

main() {
  local category=""
  local file_path=""
  
  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case $1 in
      -h|--help)
        usage
        ;;
      -c|--category)
        category="$2"
        shift 2
        ;;
      -*)
        echo "Unknown option: $1"
        usage
        ;;
      *)
        file_path="$1"
        shift
        ;;
    esac
  done
  
  # Validate file path
  if [[ -z "$file_path" ]]; then
    error "No file specified. Use -h for help."
  fi
  
  # Expand path if needed
  file_path="${file_path/#\~/$HOME}"
  
  if [[ ! -f "$file_path" ]] && [[ ! -d "$file_path" ]]; then
    error "File or directory not found: $file_path"
  fi
  
  # Auto-detect category if not specified
  if [[ -z "$category" ]]; then
    category=$(detect_category "$file_path")
    info "Auto-detected category: $category"
  fi
  
  # Validate category
  case "$category" in
    common|macos|linux)
      ;;
    *)
      error "Invalid category: $category. Use: common, macos, or linux"
      ;;
  esac
  
  # Determine destination in dotfiles
  local filename=$(basename "$file_path")
  local dest_dir=""
  
  if [[ -d "$file_path" ]]; then
    # It's a directory (like .config/nvim)
    dest_dir="$DOTFILES_DIR/config/$category/$filename"
  else
    # It's a file - determine subdirectory based on parent
    local parent=$(basename "$(dirname "$file_path")")
    if [[ "$parent" == ".config" ]] || [[ "$parent" == "$HOME" ]]; then
      # Top-level config file
      dest_dir="$DOTFILES_DIR/config/$category"
    else
      # Nested config (e.g., .config/nvim/init.lua)
      dest_dir="$DOTFILES_DIR/config/$category/$parent"
    fi
  fi
  
  local dest_path="$dest_dir/$filename"
  
  # Create destination directory
  ensure_directory "$dest_dir"
  
  # Check if already exists in dotfiles
  if [[ -e "$dest_path" ]]; then
    warning "File already exists in dotfiles: $dest_path"
    read -p "Overwrite? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      info "Aborted."
      exit 0
    fi
  fi
  
  # Copy file to dotfiles
  info "Copying $file_path to $dest_path..."
  cp -r "$file_path" "$dest_path"
  
  # Remove original and create symlink
  info "Replacing original with symlink..."
  rm -rf "$file_path"
  ln -s "$dest_path" "$file_path"
  
  # Add to git
  cd "$DOTFILES_DIR"
  git add -A
  
  success "Added $filename to dotfiles!"
  info "Don't forget to commit:"
  info "  cd $DOTFILES_DIR"
  info "  git commit -m \"Add $filename config\""
}

main "$@"
