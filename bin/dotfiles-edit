#!/usr/bin/env bash

# Dotfiles Edit - Edit a configuration file in the dotfiles repository

set -e

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$DOTFILES_DIR/scripts/common/utils.sh"

usage() {
  cat << EOF
Usage: $(basename "${BASH_SOURCE[0]}") [-h] [-e editor] <config_name>

Edit a configuration file in the dotfiles repository.

Options:
  -h, --help      Show this help message and exit
  -e, --editor    Editor to use (default: \$EDITOR or vim)
  
Examples:
  $(basename "${BASH_SOURCE[0]}") zshrc
  $(basename "${BASH_SOURCE[0]}") -e code nvim
  $(basename "${BASH_SOURCE[0]}") kanata
EOF
  exit 0
}

find_config() {
  local name="$1"
  local paths=(
    "$DOTFILES_DIR/config/common/$name"
    "$DOTFILES_DIR/config/macos/$name"
    "$DOTFILES_DIR/config/common/$name/$name.conf"
    "$DOTFILES_DIR/config/common/$name/config"
    "$DOTFILES_DIR/config/common/$name/config.toml"
    "$DOTFILES_DIR/config/common/zsh/.$name"
    "$DOTFILES_DIR/config/common/$name/.${name}rc"
    "$DOTFILES_DIR/config/common/$name/init.lua"
  )
  
  for path in "${paths[@]}"; do
    if [[ -f "$path" ]] || [[ -d "$path" ]]; then
      echo "$path"
      return 0
    fi
  done
  
  return 1
}

main() {
  local editor="${EDITOR:-vim}"
  local config_name=""
  
  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case $1 in
      -h|--help)
        usage
        ;;
      -e|--editor)
        editor="$2"
        shift 2
        ;;
      -*)
        echo "Unknown option: $1"
        usage
        ;;
      *)
        config_name="$1"
        shift
        ;;
    esac
  done
  
  # Validate config name
  if [[ -z "$config_name" ]]; then
    error "No config name specified. Use -h for help."
  fi
  
  # Find the config
  local config_path
  if ! config_path=$(find_config "$config_name"); then
    error "Config not found: $config_name"
    info "Available configs in $DOTFILES_DIR:"
    find "$DOTFILES_DIR/config" -type f -o -type d | head -20
    exit 1
  fi
  
  # Open in editor
  info "Opening $config_path with $editor..."
  $editor "$config_path"
  
  success "Done editing $config_name"
}

main "$@"
