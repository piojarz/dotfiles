#!/usr/bin/env bash

# Dotfiles Status - Check the status of dotfiles repository

set -e

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$DOTFILES_DIR/scripts/common/utils.sh"

main() {
  title "Dotfiles Status"
  
  cd "$DOTFILES_DIR"
  
  # Git status
  info "Git Status:"
  git status --short
  
  # Recent commits
  info "\nRecent Commits:"
  git log --oneline -5
  
  # Check for unpushed commits
  local unpushed=$(git log --branches --not --remotes --oneline 2>/dev/null || true)
  if [[ -n "$unpushed" ]]; then
    warning "\nUnpushed commits:"
    echo "$unpushed"
  fi
  
  # Show broken symlinks
  info "\nChecking symlinks..."
  local broken_links=0
  while IFS= read -r link; do
    if [[ -L "$link" ]] && [[ ! -e "$link" ]]; then
      warning "Broken symlink: $link"
      ((broken_links++))
    fi
  done < <(find "$HOME" -maxdepth 2 -type l 2>/dev/null)
  
  if [[ $broken_links -eq 0 ]]; then
    success "No broken symlinks found"
  else
    warning "Found $broken_links broken symlinks. Run ./install.sh to fix."
  fi
  
  # Kanata status
  if command -v kanata &> /dev/null; then
    info "\nKanata Status:"
    if is_macos; then
      if launchctl list | grep -q "com.kanata.kanata"; then
        success "Kanata service: Running"
      else
        warning "Kanata service: Not running"
        info "Start with: launchctl load ~/Library/LaunchAgents/com.kanata.kanata.plist"
      fi
    elif is_arch; then
      if systemctl --user is-active kanata.service &>/dev/null; then
        success "Kanata service: Running"
      else
        warning "Kanata service: Not running"
        info "Start with: systemctl --user start kanata.service"
      fi
    fi
  fi
  
  success "\nStatus check complete!"
}

main "$@"
