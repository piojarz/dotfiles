#!/usr/bin/env sh

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

source "$CONFIG_DIR/colors.sh" # Loads all defined colors
source "$CONFIG_DIR/icons.sh"  # Loads all defined icons

FONT="SF Pro" # Ships with macOS, needs Regular/Bold/Semibold/Heavy/Black variants

##### Bar Appearance #####
sketchybar --bar position=top          \
                 height=37             \
                 color=$BAR_COLOR      \
                 blur_radius=0         \
                 shadow=on             \
                 topmost=window

##### Changing Defaults #####
sketchybar --default icon.font="$FONT:Bold:17.0"                  \
                     icon.color=$ICON_COLOR                       \
                     icon.padding_left=4                          \
                     icon.padding_right=4                         \
                     label.font="$FONT:Semibold:14.0"              \
                     label.color=$LABEL_COLOR                     \
                     label.padding_left=4                         \
                     label.padding_right=4                        \
                     popup.background.border_width=2               \
                     popup.background.corner_radius=11             \
                     popup.background.border_color=$POPUP_BORDER_COLOR \
                     popup.background.color=$POPUP_BACKGROUND_COLOR    \
                     popup.background.shadow.drawing=on

##### Left Items #####
source "$ITEM_DIR/apple.sh"
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/front_app.sh"

##### Right Items #####
# Right-side items stack from the right edge inward, so this list reads in
# reverse of the on-screen left-to-right order: workmux | caffeine battery
# network volume clock (clock ends up at the far-right edge).
source "$ITEM_DIR/clock.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/network.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/caffeine.sh"

sketchybar --add item separator.right.1 right          \
           --set separator.right.1 icon=              \
                                    icon.font="Symbols Nerd Font:Regular:16.0" \
                                    background.padding_left=15  \
                                    background.padding_right=15 \
                                    label.drawing=off           \
                                    icon.color=$WHITE

source "$ITEM_DIR/workmux.sh"

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update

##### sketchybar-toggle: hides the bar near the screen top so the native menu #####
##### bar (set to auto-hide) can appear without overlapping. Requires         #####
##### topmost=window above; needs the native menu bar's own auto-hide setting #####
##### turned on in System Settings > Control Center.                         #####
pkill -x sketchybar-toggle
sketchybar-toggle &
