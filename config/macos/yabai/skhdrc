# SKHD Configuration
# Hotkey daemon for macOS window management
# Aligned with Hyprland key bindings using alt modifier

# ==================== FOCUS NAVIGATION ====================
# Matches Hyprland: SUPER + H/J/K/L for vim-style navigation
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# ==================== WINDOW MOVEMENT ====================
# Matches Hyprland: SUPER + SHIFT + H/J/K/L
alt + shift - h : yabai -m window --warp west
alt + shift - j : yabai -m window --warp south
alt + shift - k : yabai -m window --warp north
alt + shift - l : yabai -m window --warp east

# ==================== WINDOW MANAGEMENT ====================
# Matches Hyprland key functionality
alt - q : yabai -m window --close
alt - f : yabai -m window --toggle float
alt - space : open /Applications/Spotlight.app
alt - return : open -na kitty

# ==================== WORKSPACE NAVIGATION ====================
# Matches Hyprland: SUPER + 1-0
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9
alt - 0 : yabai -m space --focus 10

# ==================== MOVE WINDOW TO WORKSPACE ====================
# Matches Hyprland: SUPER + SHIFT + 1-0
alt + shift - 1 : yabai -m window --space 1
alt + shift - 2 : yabai -m window --space 2
alt + shift - 3 : yabai -m window --space 3
alt + shift - 4 : yabai -m window --space 4
alt + shift - 5 : yabai -m window --space 5
alt + shift - 6 : yabai -m window --space 6
alt + shift - 7 : yabai -m window --space 7
alt + shift - 8 : yabai -m window --space 8
alt + shift - 9 : yabai -m window --space 9
alt + shift - 0 : yabai -m window --space 10

# ==================== LAYOUT MANAGEMENT ====================
# Additional window management
alt - t : yabai -m window --toggle float
alt - s : yabai -m window --toggle split
alt - m : yabai -m space --mirror y-axis

# Balance tree
alt + shift - space : yabai -m space --balance

# ==================== SCREENSHOT ====================
# Matches Hyprland: SUPER + SHIFT + S
alt + shift - s : screencapture -i ~/Desktop/screenshot-$(date +%Y%m%d_%H%M%S).png

# ==================== LOCK SCREEN ====================
# Matches Hyprland: SUPER + ESCAPE
alt - escape : pmset displaysleepnow

# ==================== RELOAD ====================
# Reload configuration
alt + shift - semicolon : skhd --reload