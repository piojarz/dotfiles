{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "auto",
        "padding": {
            "top": 2,
            "left": 2
        }
    },
    "display": {
        "separator": " ➜  ",
        "color": {
            "separator": "blue"
        },
        "key": {
            "width": 12
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{6}{7}{8}"
        },
        {
            "type": "separator"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "│ ├ Kernel",
            "keyColor": "magenta"
        },
        {
            "type": "uptime",
            "key": "│ ├ Uptime",
            "keyColor": "magenta"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖 Packages",
            "keyColor": "magenta"
        },
        {
            "type": "shell",
            "key": "│ └ Shell",
            "keyColor": "magenta"
        },
        {
            "type": "de",
            "key": " DE",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "│ ├ WM",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼 Theme",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "│ └ Terminal",
            "keyColor": "blue"
        },
        {
            "type": "separator"
        },
        {
            "type": "host",
            "key": "󰌢 Host",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 CPU",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛 GPU",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "│ ├󰑭 Memory",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "│ ├󰋊 Disk",
            "keyColor": "green"
        },
        {
            "type": "battery",
            "key": "│ ├󰁹 Battery",
            "keyColor": "green"
        },
        {
            "type": "locale",
            "key": "│ └󰇥 Locale",
            "keyColor": "green"
        },
        {
            "type": "separator"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
