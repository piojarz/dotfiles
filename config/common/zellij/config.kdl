// Zellij Configuration
// Modern terminal multiplexer with better defaults and easier UX

// Session settings
session_serialization true
pane_viewport_serialization true
scrollback_lines_serialization 10000
styled_underlines true

// Theme - Tokyo Night
themes {
    tokyo-night {
        bg "#1a1b26"
        fg "#c0caf5"
        red "#f7768e"
        green "#9ece6a"
        yellow "#e0af68"
        blue "#7aa2f7"
        magenta "#bb9af7"
        cyan "#7dcfff"
        orange "#ff9e64"
        black "#15161e"
        white "#c0caf5"
    }
}

// Use Tokyo Night theme
theme "tokyo-night"

// UI settings
default_layout "dev"
default_shell "zsh"
scrollback_editor "nvim"
copy_command "pbcopy"  // macOS
// copy_command "xclip -selection clipboard"  // Linux - uncomment on Linux

// Pane settings
pane_frames true
// Toggle pane frames with Ctrl + p + z
toggle_pane_frames true

// Simplified UI - no scrollbars
show_startup_tips false
show_release_notes false

// Layouts directory
layout_dir "~/.config/zellij/layouts"

// Keybindings - Simplified to be more beginner-friendly
// Uses Ctrl+g as prefix instead of tmux's complex prefix system
keybinds {
    // Shared across all modes
    shared_except "locked" "renametab" "renamepane" {
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }
        bind "Alt n" { NewPane; }
        bind "Alt i" { NewTab; }
        bind "Alt x" { CloseFocus; }
        bind "Alt t" { SwitchToMode "Tmux"; }
    }

    // Normal mode - default state
    normal {
        bind "Ctrl p" { SwitchToMode "pane"; }
        bind "Ctrl t" { SwitchToMode "tab"; }
        bind "Ctrl h" { SwitchToMode "move"; }
        bind "Ctrl s" { SwitchToMode "search"; }
        bind "Ctrl o" { SwitchToMode "session"; }
        bind "Ctrl b" { SwitchToMode "tmux"; }
        bind "d" { Detach; }
        bind "q" { Quit; }
        bind "f" { ToggleFloatingPanes; }
        bind "v" { ToggleFocusFullscreen; }
    }

    // Locked mode - pass keys to application
    locked {
        bind "Ctrl g" { SwitchToMode "normal"; }
    }

    // Resize mode
    resize {
        bind "Ctrl n" { SwitchToMode "normal"; }
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "=" { Resize "Reset"; }
        bind "Esc" { SwitchToMode "normal"; }
    }

    // Pane mode
    pane {
        bind "Ctrl p" { SwitchToMode "normal"; }
        bind "h" "Left" { MoveFocus "Left"; }
        bind "j" "Down" { MoveFocus "Down"; }
        bind "k" "Up" { MoveFocus "Up"; }
        bind "l" "Right" { MoveFocus "Right"; }
        bind "p" { SwitchFocus; }
        bind "n" { NewPane; }
        bind "d" { NewPane "Down"; }
        bind "r" { NewPane "Right"; }
        bind "x" { CloseFocus; }
        bind "c" { Clear; }
        bind "e" { TogglePaneEmbedOrFloating; }
        bind "z" { TogglePaneFrames; }
        bind "w" { ToggleFloatingPanes; }
        bind "f" { ToggleFocusFullscreen; }
        bind "Esc" { SwitchToMode "normal"; }
    }

    // Move mode
    move {
        bind "Ctrl h" { SwitchToMode "normal"; }
        bind "h" "Left" { MovePane "Left"; }
        bind "j" "Down" { MovePane "Down"; }
        bind "k" "Up" { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }
        bind "Esc" { SwitchToMode "normal"; }
    }

    // Tab mode
    tab {
        bind "Ctrl t" { SwitchToMode "normal"; }
        bind "r" { SwitchToMode "renametab"; }
        bind "h" "Left" "Up" "k" { GoToPreviousTab; }
        bind "l" "Right" "Down" "j" { GoToNextTab; }
        bind "n" { NewTab; }
        bind "x" { CloseTab; }
        bind "s" { ToggleActiveSyncTab; }
        bind "1" { GoToTab 1; }
        bind "2" { GoToTab 2; }
        bind "3" { GoToTab 3; }
        bind "4" { GoToTab 4; }
        bind "5" { GoToTab 5; }
        bind "6" { GoToTab 6; }
        bind "7" { GoToTab 7; }
        bind "8" { GoToTab 8; }
        bind "9" { GoToTab 9; }
        bind "Esc" { SwitchToMode "normal"; }
    }

    // Scroll mode
    scroll {
        bind "Ctrl s" { SwitchToMode "normal"; }
        bind "e" { EditScrollback; }
        bind "s" { SwitchToMode "search"; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" { PageScrollDown; }
        bind "Ctrl u" { PageScrollUp; }
        bind "d" { PageScrollDown; }
        bind "u" { PageScrollUp; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }
        bind "Esc" { ScrollToBottom; SwitchToMode "normal"; }
    }

    // Search mode
    search {
        bind "Ctrl s" { SwitchToMode "normal"; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" { PageScrollDown; }
        bind "Ctrl u" { PageScrollUp; }
        bind "d" { PageScrollDown; }
        bind "u" { PageScrollUp; }
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
        bind "Esc" { ScrollToBottom; SwitchToMode "normal"; }
    }

    // Session mode
    session {
        bind "Ctrl o" { SwitchToMode "normal"; }
        bind "d" { Detach; }
        bind "q" { Quit; }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "Esc" { SwitchToMode "normal"; }
    }

    // Tmux mode - For those familiar with tmux
    tmux {
        bind "Ctrl b" { SwitchToMode "normal"; }
        bind "c" { NewTab; }
        bind "n" { GoToNextTab; }
        bind "p" { GoToPreviousTab; }
        bind "h" { MoveFocus "Left"; }
        bind "j" { MoveFocus "Down"; }
        bind "k" { MoveFocus "Up"; }
        bind "l" { MoveFocus "Right"; }
        bind "%" { NewPane "Right"; }
        bind '"' { NewPane "Down"; }
        bind "x" { CloseFocus; }
        bind "d" { Detach; }
        bind "[" { SwitchToMode "scroll"; }
        bind "z" { ToggleFocusFullscreen; }
        bind "Esc" { SwitchToMode "normal"; }
    }

    // Rename modes
    renametab {
        bind "Ctrl c" { SwitchToMode "tab"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "tab"; }
    }

    renamepane {
        bind "Ctrl c" { SwitchToMode "pane"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "pane"; }
    }
}

// Plugins
plugins {
    // Session manager - shows all sessions
    session-manager location="https://github.com/zellij-org/session-manager.wasm"
    
    // Welcome screen
    welcome-screen location="https://github.com/zellij-org/welcome-screen.wasm" {
        welcome_message "Welcome to Zellij!"
    }
}
